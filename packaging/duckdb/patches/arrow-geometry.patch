+// Schema/type validation is a recoverable C API error, not a failed SQL
+// statement. Defer only expected validation failures past the transaction
+// guard so an existing caller transaction stays usable. Severe engine errors
+// and allocation failures retain DuckDB's normal invalidation semantics.
+void RunArrowConversion(duckdb::ClientContext &context, const std::function<void(void)> &conversion) {
+	std::exception_ptr validation_error;
+	context.RunFunctionInTransaction([&]() {
+		try {
+			conversion();
+		} catch (const duckdb::Exception &ex) {
+			duckdb::ErrorData error(ex);
+			switch (error.Type()) {
+			case duckdb::ExceptionType::INVALID_INPUT:
+			case duckdb::ExceptionType::SERIALIZATION:
+			case duckdb::ExceptionType::NOT_IMPLEMENTED:
+			case duckdb::ExceptionType::CONVERSION:
+			case duckdb::ExceptionType::OUT_OF_RANGE:
+			case duckdb::ExceptionType::BINDER:
+			case duckdb::ExceptionType::CATALOG:
+			case duckdb::ExceptionType::PARSER:
+				validation_error = std::current_exception();
+				break;
+			default:
+				throw;
+			}
+		}
+	});
+	if (validation_error) {
+		std::rethrow_exception(validation_error);
+	}
+}
