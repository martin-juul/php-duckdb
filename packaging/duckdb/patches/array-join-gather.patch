 //------------------------------------------------------------------------------
 // Special cases for arrays
 //------------------------------------------------------------------------------
+// Casts the gathered rows 0..scan_count of "source" to the target array type and stores row i at target_sel[i]
+static void TupleDataCastToArray(Vector &source, Vector &target, const SelectionVector &target_sel,
+                                 const idx_t scan_count) {
+	if (!target_sel.IsSet()) {
+		VectorOperations::DefaultCast(source, target, scan_count);
+		return;
+	}
+	// The target positions are not 0..scan_count (e.g. matched rows of a LEFT JOIN), so cast into a temporary
+	// vector and copy each row to its position, leaving the other target rows untouched
+	Vector cast_result(target.GetType(), scan_count);
+	VectorOperations::DefaultCast(source, cast_result, scan_count);
+	for (idx_t i = 0; i < scan_count; i++) {
+		VectorOperations::Copy(cast_result, target, i + 1, i, target_sel.get_index(i));
+	}
+}
