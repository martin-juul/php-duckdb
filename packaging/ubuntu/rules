#!/usr/bin/make -f

# Build the pinned, patched engine from a staged source archive. Pins and the
# patch live in packaging/duckdb; builds do not download dependencies here.
DUCKDB_SOURCE_ARCHIVE ?= $(CURDIR)/duckdb-source.tar.gz
DUCKDB_BUILD_DIR ?= /tmp/php-duckdb-deb-engine

# see FEATURE AREAS in dpkg-buildflags(1)
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

# Never bake a build-tree RPATH into the shared object
# (honoured by PHP's build/php.m4: ld_runpath_switch is emptied).
export PHP_RPATH = no

# run-tests.php must not prompt, and must fail the build on test failures.
export NO_INTERACTION = 1
export DUCKDB_EXTENSION_PATH = $(CURDIR)/modules/duckdb.so

include /usr/share/dpkg/architecture.mk
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/buildflags.mk

%:
	dh $@ --with php

override_dh_auto_configure:
	DUCKDB_SOURCE_ARCHIVE="$(DUCKDB_SOURCE_ARCHIVE)" sh packaging/duckdb/build-sdk.sh \
		--prefix "$(CURDIR)/duckdb-sdk" --work-dir "$(DUCKDB_BUILD_DIR)"
	phpize
	dh_auto_configure -- --with-duckdb=$(CURDIR)/duckdb-sdk --with-php-config=/usr/bin/php-config

# PHP's build system installs with INSTALL_ROOT, not DESTDIR.
# The vendored libduckdb ships inside the package (these releases have
# none); the archive's SONAME is the unversioned libduckdb.so.
override_dh_auto_install:
	dh_auto_install -- INSTALL_ROOT=$(CURDIR)/debian/php-duckdb
	install -D -m 0755 duckdb-sdk/lib/libduckdb.so \
		$(CURDIR)/debian/php-duckdb/usr/lib/$(DEB_HOST_MULTIARCH)/libduckdb.so
	mkdir -p $(CURDIR)/debian/php-duckdb/usr/share/doc/php-duckdb/duckdb-sdk
	cp -a duckdb-sdk/share/duckdb-sdk/. \
		$(CURDIR)/debian/php-duckdb/usr/share/doc/php-duckdb/duckdb-sdk/

# The vendored lib is not on the loader path during the build, so point
# the test suite at duckdb-sdk/lib explicitly (same as the RPM %check).
override_dh_auto_test:
	LD_LIBRARY_PATH=$(CURDIR)/duckdb-sdk/lib REPORT_EXIT_STATUS=1 dh_auto_test

# PHP's `make clean` deletes every *.so in the tree
# (build/Makefile.global), including the staged vendored libduckdb —
# stash it across the clean so consecutive builds keep working.
override_dh_auto_clean:
	[ ! -f duckdb-sdk/lib/libduckdb.so ] || \
		mv duckdb-sdk/lib/libduckdb.so duckdb-sdk/lib/libduckdb.so.clean-keep
	dh_auto_clean
	[ ! -f duckdb-sdk/lib/libduckdb.so.clean-keep ] || \
		mv duckdb-sdk/lib/libduckdb.so.clean-keep duckdb-sdk/lib/libduckdb.so
