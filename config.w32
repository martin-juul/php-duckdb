// config.w32 for the duckdb PHP extension (Windows)

ARG_WITH("duckdb", "Include duckdb support", "no");

if (PHP_DUCKDB != "no") {
    if (CHECK_HEADER_ADD_INCLUDE("duckdb.h", "CFLAGS_DUCKDB", PHP_DUCKDB + "\\include") &&
        CHECK_LIB("duckdb.lib", "duckdb", PHP_DUCKDB + "\\lib")) {
        EXTENSION("duckdb", "duckdb.cpp src\\arrow.cpp src\\data_chunk.cpp src\\typed_value.cpp src\\type_classes.cpp src\\values.cpp src\\bignum_decode.cpp src\\variant_decode.cpp src\\result.cpp src\\statement.cpp src\\pending.cpp src\\suspend_swoole.cpp src\\suspend_true_async.cpp src\\suspend_amphp.cpp src\\suspend_reactphp.cpp src\\appender.cpp src\\vector.cpp src\\selection.cpp");
        // Compiling typed_value.cpp and linking duckdb.lib check the required
        // bind/fold/CRS APIs, including SDKs without API version macros.
        // duckdb.h defaults to dllimport on Windows; do not define
        // DUCKDB_STATIC_BUILD or DUCKDB_BUILD_LIBRARY for the official DLL.
        ADD_FLAG("CFLAGS_DUCKDB", "/EHsc /std:c++17");
        // Sources under src/ also include extension headers from the root.
        ADD_FLAG("CFLAGS_DUCKDB", '/I "' + configure_module_dirname + '"');
        // Pending-query notifications use Winsock socket/select primitives.
        ADD_FLAG("LIBS_DUCKDB", "ws2_32.lib");
    } else {
        ERROR("duckdb not found; install duckdb.h and the matching x64 duckdb.lib import library");
    }
}
